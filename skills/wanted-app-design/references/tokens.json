{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Wanted-inspired UI tokens",
    "description": "화면 관찰에서 추정한 추천값이며 원티드의 실제 내부 토큰이 아닙니다.",
    "baseUnit": "pt"
  },
  "color": {
    "primary": { "$type": "color", "$value": "#3366FF" },
    "primaryPressed": { "$type": "color", "$value": "#2B57E5" },
    "primaryTint": { "$type": "color", "$value": "#EEF3FF" },
    "textPrimary": { "$type": "color", "$value": "#17181A" },
    "textSecondary": { "$type": "color", "$value": "#5E626B" },
    "textTertiary": { "$type": "color", "$value": "#9398A3" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "surfaceSubtle": { "$type": "color", "$value": "#F6F7F9" },
    "divider": { "$type": "color", "$value": "#ECEEF2" },
    "iconInactive": { "$type": "color", "$value": "#7D828C" },
    "glass": { "$type": "color", "$value": "#F8F9FCC2" },
    "scrim": { "$type": "color", "$value": "#11182733" }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": { "value": 4, "unit": "pt" } },
    "sm": { "$type": "dimension", "$value": { "value": 8, "unit": "pt" } },
    "md": { "$type": "dimension", "$value": { "value": 12, "unit": "pt" } },
    "lg": { "$type": "dimension", "$value": { "value": 16, "unit": "pt" } },
    "screen": { "$type": "dimension", "$value": { "value": 20, "unit": "pt" } },
    "section": { "$type": "dimension", "$value": { "value": 32, "unit": "pt" } }
  },
  "radius": {
    "chip": { "$type": "dimension", "$value": { "value": 7, "unit": "pt" } },
    "control": { "$type": "dimension", "$value": { "value": 9, "unit": "pt" } },
    "card": { "$type": "dimension", "$value": { "value": 12, "unit": "pt" } },
    "group": { "$type": "dimension", "$value": { "value": 14, "unit": "pt" } },
    "sheet": { "$type": "dimension", "$value": { "value": 24, "unit": "pt" } },
    "floating": { "$type": "dimension", "$value": { "value": 28, "unit": "pt" } }
  },
  "component": {
    "screen": {
      "gutter": { "$type": "dimension", "$value": { "value": 20, "unit": "pt" } },
      "bottomContentInset": { "$type": "dimension", "$value": { "value": 104, "unit": "pt" } }
    },
    "button": {
      "height": { "$type": "dimension", "$value": { "value": 44, "unit": "pt" } },
      "radius": { "$type": "dimension", "$value": { "value": 9, "unit": "pt" } },
      "pressScale": { "$type": "number", "$value": 0.97 }
    },
    "chip": {
      "height": { "$type": "dimension", "$value": { "value": 30, "unit": "pt" } },
      "radius": { "$type": "dimension", "$value": { "value": 7, "unit": "pt" } }
    },
    "floatingTabBar": {
      "horizontalInset": { "$type": "dimension", "$value": { "value": 16, "unit": "pt" } },
      "bottomInset": { "$type": "dimension", "$value": { "value": 8, "unit": "pt" } },
      "height": { "$type": "dimension", "$value": { "value": 64, "unit": "pt" } },
      "radius": { "$type": "dimension", "$value": { "value": 28, "unit": "pt" } },
      "blur": { "$type": "dimension", "$value": { "value": 24, "unit": "pt" } },
      "iconSize": { "$type": "dimension", "$value": { "value": 21, "unit": "pt" } },
      "labelSize": { "$type": "dimension", "$value": { "value": 10, "unit": "pt" } }
    },
    "bottomSheet": {
      "topRadius": { "$type": "dimension", "$value": { "value": 24, "unit": "pt" } },
      "handleWidth": { "$type": "dimension", "$value": { "value": 36, "unit": "pt" } },
      "handleHeight": { "$type": "dimension", "$value": { "value": 4, "unit": "pt" } }
    },
    "icon": {
      "navigation": { "$type": "dimension", "$value": { "value": 22, "unit": "pt" } },
      "featureCanvas": { "$type": "dimension", "$value": { "value": 44, "unit": "pt" } },
      "featureArtwork": { "$type": "dimension", "$value": { "value": 32, "unit": "pt" } },
      "rowContainer": { "$type": "dimension", "$value": { "value": 28, "unit": "pt" } },
      "rowGlyph": { "$type": "dimension", "$value": { "value": 16, "unit": "pt" } }
    }
  },
  "motion": {
    "pressInMs": { "$type": "duration", "$value": { "value": 90, "unit": "ms" } },
    "pressOutMs": { "$type": "duration", "$value": { "value": 160, "unit": "ms" } },
    "shortMs": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
    "springDamping": { "$type": "number", "$value": 24 },
    "springStiffness": { "$type": "number", "$value": 260 },
    "springMass": { "$type": "number", "$value": 1 }
  }
}
